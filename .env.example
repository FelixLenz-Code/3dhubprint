# Mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 48`.
# Verschlüsselt gespeicherte Geheimnisse (Drucker-API-Keys, 2FA). Nicht nachträglich ändern!
APP_SECRET=

# Öffentliche Adresse hinter dem nginx-Reverse-Proxy
PUBLIC_URL=https://drucker.example.de

# IP(s) des nginx-Servers, dessen X-Forwarded-* Header vertraut wird (kommagetrennt)
TRUSTED_PROXIES=192.168.1.5

# true: Login nur über HTTPS (empfohlen). false: auch über http://<lan-ip>:8080
COOKIE_SECURE=true

PORT=8080
DATA_DIR=./data
